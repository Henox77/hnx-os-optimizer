<UserControl x:Class="HNXOSOptimizer.RollbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HNXOSOptimizer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="780"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollTitle]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollSubtitle]}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Warning & Restore Point Actions -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollWarnTitle]}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSecondary}" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollWarn1]}" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollWarn2]}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnCreateRestorePoint" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollBtnRestorePoint]}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="BtnCreateRestorePoint_Click"/>
                    <Button x:Name="BtnRestoreFull" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollBtnRestoreFull]}" Style="{StaticResource ModernButton}" Click="BtnRestoreFull_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions History List -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[RollHistoryTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                <!-- History list -->
                <ListView x:Name="ListHistory" Grid.Row="1" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="#FFFFFF" Padding="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tarih / Saat" DisplayMemberBinding="{Binding DateTime}" Width="160"/>
                            <GridViewColumn Header="İşlem Adı" DisplayMemberBinding="{Binding ActionName}" Width="350"/>
                            <GridViewColumn Header="Durum" DisplayMemberBinding="{Binding Status}" Width="100"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A1A2E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
