<UserControl x:Class="HNXOSOptimizer.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HNXOSOptimizer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="780"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetTitle]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetSubtitle]}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Scrollable network features -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- DNS & Flush DNS Card -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title/Info -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetDnsTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetDnsDesc]}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Select DNS -->
                        <ComboBox x:Name="ComboDns" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" SelectionChanged="ComboDns_SelectionChanged">
                            <ComboBoxItem Content="Seçiniz..." Tag="none"/>
                            <ComboBoxItem Content="Google DNS (8.8.8.8)" Tag="8.8.8.8,8.8.4.4"/>
                            <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="1.1.1.1,1.0.0.1"/>
                            <ComboBoxItem Content="Quad9 (9.9.9.9)" Tag="9.9.9.9,149.112.112.112"/>
                            <ComboBoxItem Content="OpenDNS" Tag="208.67.222.222,208.67.220.220"/>
                            <ComboBoxItem Content="AdGuard DNS" Tag="94.140.14.14,94.140.15.15"/>
                            <ComboBoxItem Content="Özel (Custom)..." Tag="custom"/>
                        </ComboBox>

                        <!-- Apply Button -->
                        <Button x:Name="BtnApplyDns" Grid.Row="0" Grid.Column="2" Content="Uygula" Style="{StaticResource ModernButton}" Width="80" Margin="10,0,0,0" Click="BtnApplyDns_Click"/>

                        <!-- Custom DNS Fields -->
                        <Grid x:Name="GridCustomDns" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Birincil DNS" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtCustomDns1" Background="#12121A" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" Padding="8,5" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="İkincil DNS" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtCustomDns2" Background="#12121A" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" Padding="8,5" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Toggles Grid -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <!-- Nagle's Algorithm Toggle -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetNagles]}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetNaglesDesc]}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleNagles" Grid.Row="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Click="ToggleNagles_Click"/>
                        </Grid>
                    </Border>

                    <!-- TCP Auto Tuning Toggle -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetTcpAuto]}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetTcpAutoDesc]}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleTcpAutoTuning" Grid.Row="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Click="ToggleTcpAutoTuning_Click"/>
                        </Grid>
                    </Border>

                    <!-- QoS Bandwidth Toggle -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetQos]}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetQosDesc]}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton x:Name="ToggleQos" Grid.Row="1" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Click="ToggleQos_Click"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- DNS Flush Bar -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetFlushDns]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetFlushDnsDesc]}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnFlushDns" Grid.Column="1" Content="DNS Önbelleğini Temizle" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="BtnFlushDns_Click"/>
                    </Grid>
                </Border>

                <!-- Hosts File Editor Card -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetHostsTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetHostsDesc]}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnHostsUndo" Content="Yedekten Dön" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Click="BtnHostsUndo_Click"/>
                                <Button x:Name="BtnHostsSave" Content="Kaydet" Style="{StaticResource ModernButton}" Padding="15,5" Click="BtnHostsSave_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="TxtHostsContent" Height="140" Background="#12121A" Foreground="#FFFFFF" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource BorderBrush}" Padding="8" BorderThickness="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- IP Utility Ping & Shodan Lookup Card -->
                <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title/Inputs -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetUtilsTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[NetUtilsDesc]}" FontSize="12" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <TextBox x:Name="TxtNetQuery" Grid.Row="1" Grid.Column="0" Background="#12121A" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" Text="8.8.8.8" VerticalContentAlignment="Center" Padding="8,6" BorderThickness="1" Margin="0,0,10,0"/>
                        <Button x:Name="BtnPing" Grid.Row="1" Grid.Column="1" Content="Ping At" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnPing_Click"/>
                        <Button x:Name="BtnShodan" Grid.Row="1" Grid.Column="2" Content="Shodan Sorgula" Style="{StaticResource ModernButton}" Background="{StaticResource AccentSecondary}" Click="BtnShodan_Click"/>

                        <!-- Diagnostic Output Box -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,12,0,0" Padding="10" MinHeight="80">
                            <TextBlock x:Name="TxtNetResult" Text="Sorgulama sonuçları burada listelenecek..." Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
