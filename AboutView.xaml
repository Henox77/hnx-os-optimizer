<UserControl x:Class="HNXOSOptimizer.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HNXOSOptimizer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="780">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BgCard}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="25" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Software logo / title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="⚡" FontSize="48" Foreground="{StaticResource AccentCyan}" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HNX OS Optimizer" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="{StaticResource MainFont}"/>
                        <TextBlock Text="Sürüm v1.0.0 | © 2025 HNX OS" FontSize="12" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MainFont}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Description -->
                <TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[AboutDesc]}" 
                           Foreground="{StaticResource TextPrimary}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,25"/>

                <!-- Contact & References (Scrollable) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Github -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[AboutGithub]}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="github.com/Henox77" FontSize="13" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="Link_MouseLeftButtonDown" Tag="https://github.com/Henox77"/>
                            </Grid>
                        </Border>

                        <!-- Instagram -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[AboutInsta]}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="@efeyylw" FontSize="13" Foreground="{StaticResource AccentSecondary}" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="Link_MouseLeftButtonDown" Tag="https://instagram.com/efeyylw"/>
                            </Grid>
                        </Border>



                        <!-- OS Compatibility -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[AboutPlatform]}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Windows 10 / 11 (x64)" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Update checker -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtUpdateStatus" Text="En son sürümü kullanıyorsunuz." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCheckUpdate" Grid.Column="1" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[AboutBtnUpdate]}" Style="{StaticResource SecondaryButton}" Click="BtnCheckUpdate_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
