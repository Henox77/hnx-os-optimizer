<Window x:Class="HNXOSOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HNXOSOptimizer"
        Title="HNX OS Optimizer" Height="680" Width="1050"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Style for Sidebar Navigation Buttons -->
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="3,0,0,0" 
                                BorderBrush="Transparent"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Icon Placeholder (Uses simple text symbols for simplicity/styling) -->
                                <TextBlock x:Name="Icon" 
                                           Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="16" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                
                                <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A1A2E"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#222238"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" ClipToBounds="True" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <!-- Root Grid with background image -->
        <Grid>
            <!-- Background Image Brush dynamically set in Code-Behind -->
            <Grid.Background>
                <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill"/>
            </Grid.Background>

            <!-- Dark Overlay (Acrylic effect) -->
            <Border Background="#F50D0D12" CornerRadius="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/> <!-- Custom Titlebar -->
                        <RowDefinition Height="*"/>  <!-- Main Area -->
                        <RowDefinition Height="35"/> <!-- Footer -->
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/> <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>   <!-- Main Content -->
                    </Grid.ColumnDefinitions>

                    <!-- Custom Title Bar (Extends across both columns) -->
                    <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#12121A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Logo & Title -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HNX OS Optimizer" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource MainFont}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Window Control Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="35" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Style="{StaticResource SecondaryButton}" Click="BtnMinimize_Click"/>
                            <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="35" Height="30" Background="Transparent" Foreground="#FF5F56" BorderThickness="0" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Sidebar Panel -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#9912121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,15,0,0">
                                <RadioButton x:Name="BtnMenuHome" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuHome]}" Tag="" Style="{StaticResource SidebarButton}" IsChecked="True" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuPerf" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuPerf]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuPriv" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuPriv]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuNet" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuNet]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuClean" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuClean]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuTools" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuTools]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuRollback" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuRollback]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                                <RadioButton x:Name="BtnMenuAbout" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[MenuAbout]}" Tag="" Style="{StaticResource SidebarButton}" Checked="NavButton_Checked"/>
                            </StackPanel>

                            <!-- Social Links & Language Selector in Sidebar Bottom -->
                            <StackPanel Grid.Row="1" Margin="15,5" VerticalAlignment="Bottom">
                                <TextBlock Text="Language / Dil" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ComboLang" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" 
                                          FontSize="12" Padding="6,3" SelectionChanged="ComboLang_SelectionChanged" Margin="0,0,0,10"/>
                                <TextBlock Text="Henox77 @ GitHub" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="efeyylw @ Instagram" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Content Presenter -->
                    <ContentControl x:Name="ContentArea" 
                                    Grid.Row="1" 
                                    Grid.Column="1" 
                                    Margin="20,20,20,10"
                                    Focusable="False"/>

                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Sidebar Bottom Version -->
                            <TextBlock Grid.Column="0" Text="v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="15,0"/>
                            <!-- Main Content Bottom Branding -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="⚡ HNX OS" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[FooterCopyright]}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
