<UserControl x:Class="HNXOSOptimizer.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HNXOSOptimizer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="780">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Content Cards -->
            <RowDefinition Height="Auto"/> <!-- Status Panel -->
            <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeTitle]}" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource MainFont}" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeSubtitle]}" FontSize="13" FontFamily="{StaticResource MainFont}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Hardware & System Info Cards -->
        <UniformGrid Grid.Row="1" Columns="2" Rows="3" Margin="0,0,0,20">
            <!-- OS Card -->
            <Border Background="{StaticResource BgCard}" Margin="8" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeOS]}" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtOS" Text="Yükleniyor..." FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CPU Card -->
            <Border Background="{StaticResource BgCard}" Margin="8" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeCPU]}" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtCPU" Text="Yükleniyor..." FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Memory Card -->
            <Border Background="{StaticResource BgCard}" Margin="8" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeRAM]}" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtRAM" Text="Yükleniyor..." FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- GPU Card -->
            <Border Background="{StaticResource BgCard}" Margin="8" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeGPU]}" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtGPU" Text="Yükleniyor..." FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Storage Card -->
            <Border Background="{StaticResource BgCard}" Grid.ColumnSpan="2" Margin="8" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeDisk]}" FontSize="12" Foreground="{StaticResource TextMuted}" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDisk" Text="Yükleniyor..." FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Progress Overlay (Only visible when active) -->
        <Border x:Name="ProgressPanel" Grid.Row="2" Background="#EA1E1E2A" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8" Padding="15" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="TxtProgressStatus" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[HomeProgressStatus]}" FontSize="14" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="14" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="OptProgressBar" Style="{StaticResource WavyProgressBar}" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="3" Margin="8,10,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnQuickOpt" Grid.Column="0" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[BtnQuickOpt]}" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnQuickOpt_Click"/>
            <Button x:Name="BtnFullOpt" Grid.Column="1" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[BtnFullOpt]}" Style="{StaticResource ModernButton}" Background="{StaticResource AccentSecondary}" Margin="8,0,8,0" Click="BtnFullOpt_Click"/>
            <Button x:Name="BtnRollback" Grid.Column="2" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[BtnRollback]}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnRollback_Click"/>
        </Grid>
    </Grid>
</UserControl>
