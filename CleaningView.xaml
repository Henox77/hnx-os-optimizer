<UserControl x:Class="HNXOSOptimizer.CleaningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HNXOSOptimizer"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="780"
             Loaded="UserControl_Loaded">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanTitle]}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}"/>
            <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanSubtitle]}" FontSize="13" Foreground="{StaticResource TextSecondary}" FontFamily="{StaticResource MainFont}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content Area split into columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Cache cleaner & Startup programs -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cache cleaner -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanCacheTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkTemp" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanTemp]}" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkPrefetch" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanPrefetch]}" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkUpdateCache" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanUpdateCache]}" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkRecycle" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanRecycle]}" Margin="0,0,0,15" IsChecked="True"/>
                        <Button x:Name="BtnClean" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanBtn]}" Style="{StaticResource ModernButton}" Click="BtnClean_Click"/>
                    </StackPanel>
                </Border>

                <!-- Startup Programs -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanStartupTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}" Margin="0,0,0,8"/>
                        
                        <!-- Startup list -->
                        <ListBox x:Name="ListStartup" Grid.Row="1" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="5">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding Command}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Location}" Foreground="{StaticResource TextSecondary}" FontSize="9"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Kaldır" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="8,4" FontSize="11" Click="BtnRemoveStartup_Click" Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Text="* Başlangıç öğesini silmek bu programın açılışta yüklenmesini engeller." FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: UWP Uninstaller -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" Margin="10,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanUwpTitle]}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="{StaticResource MainFont}" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanUwpWarn]}" FontSize="11" Foreground="{StaticResource AccentSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <!-- App List -->
                    <ListBox x:Name="ListUwpApps" Grid.Row="2" Background="#12121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,10" Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="5" VerticalContentAlignment="Center">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding PackageName}" Foreground="{StaticResource TextMuted}" FontSize="10" TextTrimming="CharacterEllipsis" Width="250"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="BtnUninstallUwp" Grid.Row="3" Content="{Binding Source={x:Static local:LocalizationProvider.Instance}, Path=[CleanUwpBtn]}" Style="{StaticResource ModernButton}" Background="{StaticResource AccentSecondary}" Click="BtnUninstallUwp_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
